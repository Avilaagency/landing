<script>
(function(){
if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
var last=0,glyphs=['✦','✧','✨','·'];
function spark(x,y){
var s=document.createElement('span');s.className='sp';
s.textContent=glyphs[Math.floor(Math.random()*glyphs.length)];
s.style.left=x+'px';s.style.top=y+'px';
s.style.fontSize=(10+Math.random()*16)+'px';
s.style.setProperty('--dx',(Math.random()*60-30)+'px');
s.style.setProperty('--dy',(Math.random()*60-10)+'px');
document.body.appendChild(s);
setTimeout(function(){s.remove()},950);
}
addEventListener('pointermove',function(e){
var n=Date.now();if(n-last<45)return;last=n;spark(e.clientX,e.clientY);
});
addEventListener('pointerdown',function(e){
for(var i=0;i<14;i++)spark(e.clientX+Math.random()*30-15,e.clientY+Math.random()*30-15);
});
})();
</script>
<script>
(function(){
var el=document.getElementById('roas15');
if(!el||matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))return;
el.textContent='0x';
var io=new IntersectionObserver(function(en){
if(!en[0].isIntersecting)return;io.disconnect();
var t0=performance.now();
(function f(t){var p=Math.min((t-t0)/1600,1);
el.textContent=Math.round(15*(1-Math.pow(1-p,3)))+'x';
if(p<1)requestAnimationFrame(f);})(t0);
},{threshold:.5});
io.observe(el);
})();
</script>
