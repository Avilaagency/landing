<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ávila — Agencia creativa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A0A0A;--ink:#FFFFFF;--gold:#D4AF37;--mut:#B5B0A3;--line:#D4AF3755;color-scheme:dark;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Cormorant Garamond',Georgia,serif;font-size:1.2rem;line-height:1.6;overflow-x:hidden}
.wrap{max-width:1000px;margin:0 auto;padding:0 24px;position:relative}
nav{display:flex;justify-content:space-between;align-items:center;padding:22px 0}
nav a{color:var(--ink);text-decoration:none}
.btn{border:1px solid var(--gold);color:var(--gold);padding:8px 22px;border-radius:99px;font-size:1.05rem}
a:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.shine{background:linear-gradient(105deg,#9C7A1E 0%,#F6E27A 25%,#FFF8D6 38%,#D4AF37 52%,#8A6A14 70%,#F6E27A 85%,#9C7A1E 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:glint 5s linear infinite}
@keyframes glint{from{background-position:120% 0}to{background-position:-130% 0}}
.hero{text-align:center;padding:9vh 0 12vh}
.mark{font-family:'Allura','Snell Roundhand','Brush Script MT',cursive;font-weight:400;font-size:clamp(6rem,28vw,16rem);line-height:1.15;margin:0;padding:0 .1em}
.hero p{font-size:clamp(1.3rem,3.4vw,1.9rem);max-width:20em;margin:6px auto 36px;line-height:1.35;letter-spacing:.02em}
.hint{display:block;margin-top:22px;font-size:.95rem;color:var(--mut);font-style:italic}
.cta{display:inline-block;background:linear-gradient(120deg,#B8922B,#F6E27A,#D4AF37);color:#0A0A0A;font-weight:600;padding:14px 32px;border-radius:99px;text-decoration:none;font-size:1.1rem}
section{border-top:1px solid var(--line);padding:56px 0;text-align:center}
h2{font-weight:400;font-style:italic;font-size:clamp(2rem,6vw,3.2rem);line-height:1.15;margin:0 0 26px}
.clients{list-style:none;margin:0;padding:0}
.clients li{font-size:clamp(1.7rem,5.6vw,3rem);padding:12px 0;line-height:1.15;letter-spacing:.03em}
.clients li+li:before{content:"✦";display:block;color:var(--gold);font-size:.9rem;margin-bottom:14px}
.marquee{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.track{display:flex;gap:48px;width:max-content;animation:run 36s linear infinite}
.marquee:hover .track{animation-play-state:paused}
.cl{display:flex;align-items:center;gap:14px;font-size:1.5rem;white-space:nowrap}
.badge{width:54px;height:54px;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);font-size:1.15rem;font-weight:600;letter-spacing:.04em;flex:none}
@keyframes run{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.marquee{overflow-x:auto}.track{animation:none}}
.serv{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px}
.serv h3{font-weight:600;font-size:1.7rem;margin:0 0 6px;color:var(--gold)}
.serv p{margin:0;color:var(--mut)}
.hero{position:relative;isolation:isolate}
.hero>*:not(.avila-mt):not(.fc){position:relative;z-index:2}
.logo-wrap h1{position:relative;z-index:1}
.avila-mt{position:absolute;left:50%;top:50%;width:100vw;max-width:none;height:150%;transform:translate(-50%,-50%);z-index:0;fill:none;stroke:var(--gold);stroke-width:1;opacity:.85;pointer-events:none}
.avila-mt path{vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:0;animation:draw 3.5s ease-out both}
.avila-mt .l2{opacity:.4;animation-delay:.6s}
@keyframes draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
.fc{position:absolute;z-index:1;width:clamp(78px,17vw,150px);aspect-ratio:4/5;border:1px solid var(--line);border-radius:10px;background:linear-gradient(160deg,#241c07,#0A0A0A 70%);padding:8px;display:flex;flex-direction:column;gap:6px;overflow:hidden;box-shadow:0 0 24px #D4AF3722;opacity:.9}
.fc i{display:block;width:34%;height:6px;border-radius:9px;background:var(--gold);opacity:.7}
.fc b{flex:1;display:grid;place-items:center;font-size:clamp(1.6rem,5vw,3rem);color:var(--gold);font-weight:400;background:radial-gradient(circle,#D4AF3733,transparent 70%);border-radius:6px}
.fc u{display:block;height:4px;border-radius:9px;background:var(--line)}
.fc u+u{width:60%}
.c1{left:0;top:2%;transform:rotate(-7deg)}
.c2{right:0;top:6%;transform:rotate(6deg)}
.c3{left:2%;bottom:6%;transform:rotate(5deg)}
.c4{right:2%;bottom:3%;transform:rotate(-6deg)}
@media (prefers-reduced-motion:reduce){.avila-mt path{animation:none}}
:root{--photo:url("data:image/jpeg;base64,")}
.fc{padding:0;background:var(--photo) center/240% no-repeat;opacity:1}
.c1{background-position:30% 38%;background-size:230%}
.c2{background-position:82% 28%;background-size:270%}
.c3{background-position:55% 88%;background-size:240%}
.c4{background-position:96% 58%;background-size:240%}
.phonesec{display:flex;flex-wrap:wrap;gap:44px;align-items:center;justify-content:center}
.phone{width:min(250px,68vw);aspect-ratio:9/18;border:2px solid var(--gold);border-radius:36px;padding:9px;background:#000;box-shadow:0 0 44px #D4AF3733}
.screen{height:100%;border-radius:27px;overflow:hidden;background:#0A0A0A}
.feed{animation:flick 18s cubic-bezier(.65,0,.35,1) infinite}
@keyframes flick{0%,18%{transform:translateY(0)}25%,43%{transform:translateY(-12.5%)}50%,68%{transform:translateY(-25%)}75%,93%{transform:translateY(-37.5%)}100%{transform:translateY(-50%)}}
.post{padding:10px 10px 14px;text-align:left}
.ph{display:flex;align-items:center;gap:8px;font-size:.85rem;margin-bottom:8px}
.av{width:22px;height:22px;border-radius:50%;border:1px solid var(--gold);background:radial-gradient(circle,#D4AF37,#6b5513)}
.im{aspect-ratio:1;border-radius:8px;background-image:var(--photo);background-repeat:no-repeat}
.ac{color:var(--gold);font-size:1.1rem;letter-spacing:.3em;margin:8px 0 6px}
.ln{height:5px;border-radius:9px;background:var(--line);margin-top:6px}
.ln.s{width:55%}
.ptxt{max-width:22em;text-align:left}
.ptxt h2{margin-bottom:12px}
@media (max-width:640px){.ptxt{text-align:center}}
@media (prefers-reduced-motion:reduce){.feed{animation:none}}
:root{--photo2:url("data:image/jpeg;base64,")}
.c1{background:var(--photo) center/cover no-repeat;aspect-ratio:3/4;width:clamp(96px,23vw,190px)}
.c2{background:var(--photo2) center/cover no-repeat;aspect-ratio:4/3;width:clamp(120px,29vw,250px);top:auto;bottom:6%;right:0;transform:rotate(-5deg)}
.vid{width:min(250px,66vw);aspect-ratio:480/480;margin:0 auto 28px;border:2px solid var(--gold);border-radius:22px;overflow:hidden;background:#000;box-shadow:0 0 40px #D4AF3733}
.vid video{width:100%;height:100%;object-fit:cover;display:block}
.lg{display:flex;align-items:center;background:#fff;border-radius:14px;height:60px;padding:7px 12px}
.lg img{height:100%;width:auto;max-width:130px;object-fit:contain;display:block}
.lgc{display:block;width:60px;height:60px;border-radius:50%;overflow:hidden;flex:none}
.lgc img{width:100%;height:100%;display:block}
.case{padding:20px 0}
.case small{display:block;font-size:1.05rem;letter-spacing:.3em;text-transform:uppercase;color:var(--mut)}
.case h3{font-weight:600;font-size:clamp(2rem,7vw,3.4rem);letter-spacing:.12em;margin:8px 0 0}
.big{font-size:clamp(7rem,32vw,17rem);font-weight:600;line-height:1;margin:8px 0 0}
.roas{letter-spacing:.35em;font-size:1.2rem;color:var(--ink);margin:0}
.pais{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.pais span{border:1px solid var(--gold);border-radius:99px;padding:8px 24px;font-size:1.2rem}
.note{color:var(--mut);max-width:30em;margin:0 auto 26px}
footer{padding:36px 0 44px;color:var(--mut);font-size:1rem;text-align:center}
.sp{position:fixed;pointer-events:none;z-index:50;color:var(--gold);text-shadow:0 0 8px #F6E27A;animation:sp .9s ease-out forwards}
@keyframes sp{from{opacity:1;transform:translate(0,0) scale(1) rotate(0)}to{opacity:0;transform:translate(var(--dx),var(--dy)) scale(.2) rotate(120deg)}}
@media (prefers-reduced-motion:reduce){.shine{animation:none}}
</style>
</head>
<body>
